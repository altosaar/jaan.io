---
// Readable, edge-aligned column for Markdown content pages (about, faq, terms,
// schedule, partners, and the rest). The rendered Markdown arrives via <slot/>,
// so its elements are styled with :global() below.
interface Props {
  /**
   * Where the closing back-link points, or `null` for none — which is the
   * default and what every route currently uses. The nav is fixed and always on
   * screen, so a second way home at the bottom of the page was repeating an
   * offer the visitor already had. Still supported for a page that ends
   * somewhere the nav cannot take you.
   */
  backHref?: string | null;
  backLabel?: string;
}

const { backHref = null, backLabel = "← Back home" } = Astro.props;
---

<div class="prose">
  <slot />
  {
    /* set:html rather than a child expression: .prose-back is an underlined
      inline-block, so a stray whitespace text node either side of the label
      would render as underlined space. A self-closing tag can't collect any. */
  }
  {backHref && <a href={backHref} class="prose-back" set:html={backLabel} />}
</div>

<style>
  .prose {
    width: var(--site-w);
    margin-left: var(--site-ml);
    max-width: var(--reading-w);
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  /* The post title, and only the post title: src/pages/[slug].astro names it
     .post-title for exactly this reason. */
  .prose :global(h1) {
    margin-bottom: 1.25rem;
  }

  /* Anything reachable by a #fragment has to clear the fixed nav when it is
     jumped to, or the heading you clicked lands underneath it and the section
     appears to start at its second paragraph. The extra 1rem is the same line
     the table of contents measures against (Toc.astro), so the heading you
     land on is the one the rail then lights up.

     The post title picks the rule up harmlessly — nothing links to it. A
     post's sections may be `##` or `#`, whichever it opens with, and either
     way they are the rail's destinations (Toc.astro measures the shallowest
     level rather than assuming one). */
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  /* A BODY `#` IS A SECTION, NOT A SECOND TITLE.
     Without this rule it is both: base.css sets every h1 at --fs-h1 (3rem,
     weight 700), the article title's own size, so a post that opens its
     sections with `#` gets a column of headings as large as its headline —
     the regression the physics post hit and which demoting its Markdown fixed
     at the time. the-gab-lab.md does open its sections with `#` (see the port
     note in that file: it is what gets the contents rail, which lists a post's
     shallowest heading level), so this is the rule that makes that safe for
     any post.

     ITS SIZE IS A STEP OF ITS OWN, between the title and h2, and that step is
     the point. Promoting a post's headings moves every level up one, so the
     `##` beneath these is now an h2 — and if a body h1 simply borrowed the h2
     treatment, a section and its sub-sections would set at the same 32px and
     the outline would read flat. Sized here, the ramp down the page is 48 /
     38 / 32 / 24, and the 3.6vw tracks h2's 3vw so the gap holds at every
     width rather than only at the cap.

     .post-title is set in src/pages/[slug].astro. The :not() also outranks the
     .prose h1 rule above on specificity, so this margin wins over its
     margin-bottom rather than depending on which rule the bundler emits
     second. */
  .prose :global(h1:not(.post-title)) {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 2.375rem);
    font-weight: 700;
    letter-spacing: calc(-0.015em + var(--track-sans));
    margin: 2.5rem 0 0.875rem;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: calc(-0.01em + var(--track-sans));
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* A dateline — the small muted line under a title, before the article opens.
     Opt in with class="prose-dateline" (src/pages/[slug].astro).

     It lives HERE, in the component that owns the slotted content, and not in
     the page that writes the element, because of how the two selectors weigh
     up. A page's scoped `.post-year` compiles to `.post-year[data-astro-cid-…]`
     — two class-likes, no element — while the rule above compiles to
     `.prose[data-astro-cid-…] p`, two class-likes AND an element, which is
     heavier. So a page trying to restyle its own dateline silently loses the
     font size and the margin while keeping the colour, which is exactly what
     the previous `.post-date` did: it read as body text with a paragraph's
     tail for as long as it existed, and looked close enough to intentional
     that nobody caught it. Adding the element to this selector puts it
     unambiguously on top and leaves the page nothing to get wrong. */
  .prose :global(p.prose-dateline) {
    /* On the sans, not the body serif: the dateline is a label about the
       article rather than a line of it, and setting it in --font-display —
       the same face as the headline right above it — says so without needing
       a rule, a bracket or a smaller size to do the separating. */
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: calc(-0.01em + var(--track-sans));
    margin: 2rem 0 0.625rem;
  }

  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    font-size: var(--fs-md);
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }

  /* ── The `#` that appears beside a heading on hover ──────────────────────
     Every heading in a Markdown body carries an empty <a class="heading-anchor">
     pointing at its own id; src/lib/rehype-heading-anchors.mjs puts it there and
     explains why it has to be empty (the short version: a text node inside a
     heading ends up in the heading's TEXT, and so in the contents rail).

     It is the counterpart to the rail listing only a post's top level. The rail
     addresses the sections; this addresses every heading, so a `###` can break
     up a long section without being unlinkable.

     ON HOVER AND FOCUS, NOT ALWAYS. A permalink is something you go looking
     for, and a column of grey #s down the left of every heading is a piece of
     apparatus asking to be read as punctuation. Hidden by OPACITY rather than
     display, so it keeps its space in the line at all times: revealing it by
     display would re-wrap the last word of a long heading under the pointer,
     which is a heading that moves when you approach it.

     Nothing reveals it on a touch screen, which has no hover — the same
     condition under which the rail is display:none. Both are desktop
     affordances for an address you can copy; neither is a way to read. */
  .prose :global(.heading-anchor) {
    /* The chrome voice, like the rail: this is navigation attached to the
       content, not a word of it. */
    font-family: var(--font-chrome);
    font-size: 0.7em;
    font-weight: 400;
    color: var(--text-muted);
    /* Not `a:not([class])`, so it takes none of base.css's underline — but the
       reset is written out anyway, since a future `.prose a` rule would
       otherwise put a rule under the glyph. */
    text-decoration: none;
    box-shadow: none;
    margin-left: 0.4em;
    /* Vertically where the text sits, not where the glyph's own box would put
       it — `#` is a full-height character in a smaller size. */
    vertical-align: baseline;
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .prose :global(.heading-anchor::before) {
    content: "#";
  }

  .prose :global(:is(h1, h2, h3, h4, h5, h6):hover .heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  /* --text rather than --accent: this is a glyph rendered in the colour, not a
     fill behind one, and --accent is chosen to be read as a background across
     the palettes. --text is the one colour guaranteed to carry text on any of
     them. */
  .prose :global(.heading-anchor:hover),
  .prose :global(.heading-anchor:focus-visible) {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .prose :global(.heading-anchor) {
      transition: none;
    }
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    line-height: 1.6;
  }

  /* The font-size is not decoration — without it a list changes size depending
     on how the author spaced it. Markdown makes a list "loose" when there is a
     blank line between items, and wraps each item's text in a <p>; a "tight"
     list leaves the text bare in the <li>. The <p> rule above sets --fs-body,
     so a loose list rendered at 1.3rem while a tight one fell back to the
     inherited --fs-base of 1rem — a 30% jump between two lists on the same
     page, decided by invisible whitespace in the source. The GRE post has one
     of each, four paragraphs apart. Setting it here makes both lists agree, and
     it is the same value the <p> rule already applies, so loose lists are
     unchanged. Nested lists need no exception: --fs-body is a rem, which is
     root-relative and so cannot compound down the levels. */
  .prose :global(li) {
    font-size: var(--fs-body);
    margin-bottom: 0.375rem;
  }

  /* ── Long-form additions ────────────────────────────────────────────────
     The upstream template styled ~500-word pages: h1/h2/p/ul/li and nothing
     else. These posts run to 6,700 words with figures, footnotes, embedded
     iframes and several hundred equations, so everything below is the part
     that had no styling at all and would otherwise fall back to UA defaults
     (serif text, blue links, white code blocks punching a hole in the dark
     page). */

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line);
    color: var(--text-muted);
  }

  /* ── Citation tiles ───────────────────────────────────────────────────────
     A reference, on a plate of its own, folded shut until it is wanted. Written
     in Markdown as a `> [!cite]` blockquote and turned into
     <details class="citation"> by src/lib/remark-citation.mjs, which is where
     the syntax and the reasoning for it live.

     THE SAME PLATE AS THE SIGNUP CARD, deliberately, and the numbers are copied
     rather than approximated: --card is the first step of the grey ramp above
     --bg (tokens.css), and the padding is .newsletter__card's own
     `clamp(1rem, 3vw, 1.25rem) clamp(1rem, 3vw, 1.875rem)` — unequal on the two
     axes, which is the shape a box wider than it is tall wants. So the two
     objects on the site that sit ON something rather than IN the page read as
     one material. If that card's plate is ever repointed, this follows it as
     far as the token goes; the padding would have to be moved by hand, which is
     the cost of it being a component's private value rather than a token.

     Square corners come from --hover-radius being 0 site-wide (tokens.css). It
     is named rather than hardcoded so a future rounded palette rounds these
     too, instead of leaving them the one sharp object on the page.

     No border and no left rule: the fill IS the edge, which is the same bargain
     .newsletter__input makes one step further up the ramp. A citation that also
     carried the blockquote's 2px left rule read as two treatments of one idea.

     TEXT STAYS --text AND FULL STRENGTH. The plate is doing the separating, so
     the type does not also have to — and --text on --card is a pair
     scripts/contrast-check.mjs already holds at 4.5:1 (it is the signup card's
     heading). Muting it would have meant a second checked pair for a gain the
     background already delivers, and links inside a citation inherit their
     colour (see `a:not([class])` in base.css), so a muted tile would have
     produced links dimmer than the underline drawn beneath them. */
  .prose :global(.citation) {
    margin: 1.5rem 0;
    padding: clamp(1rem, 3vw, 1.25rem) clamp(1rem, 3vw, 1.875rem);
    background: var(--card);
    border-radius: var(--hover-radius);
  }

  /* One step down from body copy — --fs-md against --fs-body, 1.4rem against
     1.5rem. Small on purpose: reference matter is set below running text
     everywhere it appears, and at the same size the tile reads as a highlighted
     paragraph rather than as apparatus. It is not smaller than that because
     --fs-sm is currently the same 1.5rem as --fs-body (tokens.css), so the
     scale has exactly one step available here and this is it. */
  .prose :global(.citation p) {
    font-size: var(--fs-md);
    margin-bottom: 0.75rem;
  }

  /* ── The lid ──────────────────────────────────────────────────────────────
     A <summary> is a button, and every browser gives it a disclosure triangle
     on the LEFT that cannot be styled — only removed, which takes two rules
     because Firefox reads `list-style` and Safari only its own pseudo-element.
     With the marker gone the row is an ordinary flex line: the label takes the
     left edge, on the same vertical as the tile's own text and as the prose
     above it, and the caret is pushed to the right edge by `space-between`, so
     a closed tile reads as a labelled bar with its control where a control
     goes.

     THE LABEL IS THE SITE'S SECTION LABEL, one size down. Same face, same
     weight, same 0.15em — see .section-heading in SectionHeading.astro, which
     is the voice this site uses for "this is a label, not prose" everywhere
     else. At 0.75rem against the tile's 1.4rem body it reads as a tab on the
     box rather than as a line of it. Full-strength --text, like the rest of
     the tile: see the note above on why nothing in here is dimmed. */
  .prose :global(.citation__summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .prose :global(.citation__summary::-webkit-details-marker) {
    display: none;
  }

  /* The gap under the lid is set on the first thing BELOW it, not as a bottom
     margin on the summary itself. Both look identical at rest; only this one
     animates. A margin on the summary sits outside ::details-content, so it
     would appear and vanish in one frame at each end of the slide, jolting the
     text by 0.75rem just as it starts to move. */
  .prose :global(.citation > summary + *) {
    margin-top: 0.75rem;
  }

  .prose :global(.citation__label) {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* The carousel's caret and the carousel's flip: same glyph, same half turn
     (.card__toggle-icon in Carousel.astro). It is DRAWN pointing up, because
     there it opens a panel that rises; here the tile opens downward, so the
     resting state is the drawn glyph turned over and opening unrolls it back to
     0. Turning through −180° rather than +180° is what makes it travel the same
     way round as the carousel's.

     The CURVE is no longer the carousel's, which is the one thing here that
     deliberately parts company with it: the caret rides the box's own duration
     and easing (see Opening, below) so the two stop together. On the carousel's
     0.3s the caret used to land while the box was still growing, which read as
     two animations rather than one thing opening. */
  .prose :global(.citation__caret) {
    flex-shrink: 0;
    opacity: 0.85;
    transform: rotate(-180deg);
    transition: transform var(--citation-dur) var(--citation-ease);
  }
  .prose :global(.citation[open] .citation__caret) {
    transform: rotate(0deg);
  }

  /* Hover only on hover-capable devices — on touch, :hover sticks after a tap
     and would leave the label green until you tapped elsewhere. Touch gets
     :active, which flashes during the press and clears on release. The focus
     ring is base.css's global one; the colour swap alone would not be an
     indicator. */
  @media (hover: hover) {
    .prose :global(.citation__summary:hover) {
      color: var(--accent);
    }
  }
  .prose :global(.citation__summary:active) {
    color: var(--accent);
  }

  /* The caret is the one thing here that moves. Reduced motion keeps the flip,
     drops the travel. */
  @media (prefers-reduced-motion: reduce) {
    .prose :global(.citation__caret) {
      transition: none;
    }
  }

  /* ── Opening ──────────────────────────────────────────────────────────────
     0.5s of `ease-in-out`, and the content fades up over the same 0.5s. The
     shape of this — one duration driving the box, the fade and the caret
     together — is the Figma Config FAQ accordion
     (config.figma.com/san-francisco/faq), which is `grid-template-rows 0.4s
     ease, opacity 0.4s ease` on the panel and `transform 0.4s ease` on the
     chevron.

     THE CURVE IS NOT THEIRS, AND THE REASON IS THE DISTANCE. Their answers are
     three or four lines, so an accordion there travels ~120px; the
     five-reference Background tile under "Foundations" travels 670. `ease`
     leaves the mark with velocity already on the clock — 9% of the distance
     inside the first 10% of the time — which over 670px peaks at about 3800
     px/s and lands as a shove rather than as a box opening. `ease-in-out`
     starts from a standstill (2% in the first 10%), and at 0.5s peaks near
     2300. Same arrival, about 40% less speed through the middle, and the short
     tiles — 84px of travel — are far below the threshold where anyone could
     tell the two curves apart.

     WHY NOT SLOWER STILL: 0.6s takes another 400 px/s off the peak, but the
     three-line tiles are the common case on this page (there are about thirty
     of them and most are one reference), and at 0.6s those read as sluggish.
     0.5s is the point where the tall one has stopped shoving and the short ones
     have not started dragging.

     IT USED TO BE THE MENU'S SPRING — the critically damped linear() curve the
     mobile menu and the carousel's testimonial panel travel on. A spring is
     right for a panel of fixed height; on a tile that can be three lines or
     forty it is not, because the curve dumps most of its distance in the first
     third and then crawls. That was the same fault as `ease`, one degree worse.

     WHAT WOULD ACTUALLY BE RIGHT is a duration that scales with the distance,
     so every tile travels at one speed instead of in one time. CSS cannot do
     it: there is no way to read an element's height into a <time>, and the
     tile's height is not known until it is laid out, so it cannot be written in
     by the plugin either. It would take JavaScript measuring scrollHeight on
     every toggle — which is what this whole file is built to avoid. One
     duration for every tile is the compromise, and 0.5s is where it was set.

     THE TILE IS A TWO-ROW GRID: the summary, then ::details-content, whose
     track goes 0fr → 1fr. The summary's track is `min-content` and NOT `auto`,
     which is not a nicety — see "the label used to bob", below.

      An fr track measures its own contents, so this is
     the one way to animate a box to its natural height that needs neither a
     measured pixel value nor `auto` as an animatable value — the trick every
     CSS-only accordion has used since subgrid-era Firefox, applied to the
     pseudo-element the platform now gives us instead of to a wrapper div we
     would have to emit. `min-block-size: 0` on the content is what lets the
     0fr track actually reach zero (a grid item's automatic minimum size would
     otherwise floor it at its content), and `overflow: hidden` is what clips
     the text while the track is shorter than it. Nothing here is JavaScript,
     and nothing measures a height.

     WHAT THIS REPLACED, AND WHY. The obvious spelling — transition
     ::details-content's `block-size` from 0 to auto under
     `interpolate-size: allow-keywords` — is the one the CSSWG blessed and the
     one every write-up shows, and it runs in exactly one engine. Blink shipped
     `interpolate-size` in 2024; as of Firefox 153 and Safari 26 neither Gecko
     nor WebKit has it, and both fail SILENTLY and in the worst possible way:
     they support ::details-content, so they honour `block-size: 0` and clip the
     tile shut, then jump straight to `auto` with no interpolation in between.
     The tile worked — it just snapped, which is what it did on this site until
     this rule was rewritten. The grid version animates in all three.

     WHERE THIS DOES NOT RUN, it degrades to what a <details> has always done:
     `@supports selector(::details-content)` is what keeps the grid off engines
     without the pseudo-element (Safari before 18.4, Firefox before 139), where
     `grid-template-rows: min-content 0fr` would otherwise collapse the FIRST
     PARAGRAPH of the tile — with no pseudo to slot into, the children are
     themselves the grid items — rather than its content box. There, and under reduced motion below, the
     tile opens in one frame, which is the behaviour every browser had until
     2024. That is deliberate for reduced motion: this is a box growing under
     the pointer, the kind of travel that setting asks to lose.

     ONE ASYMMETRY, ACCEPTED. Closing is a full slide only in Blink. Gecko
     shrinks the plate with the text already gone (it does not hold the
     `content-visibility: hidden` the UA sets on a closed ::details-content
     through the `allow-discrete` transition), and WebKit collapses the track in
     one frame. Opening — the direction you watch, because it is the one that
     reveals something — travels everywhere.

     THE LABEL USED TO BOB, and this was the whole of what read as bounce. An
     `auto` track is a STRETCHABLE one: with the default `align-content`, auto
     tracks absorb whatever space the grid thinks is going spare. Mid-transition
     the fr track is deliberately shorter than the content it holds, so the
     summary's auto track ate the difference — swelling from 20px to 187px and
     back on the big tile, and carrying the label and caret ~99px down the page
     and back up with it, because a <summary> is a stretched grid item and this
     one centres its flex line. The tile's TOTAL height was correct throughout;
     only the split between the two tracks was wrong, which is why this looked
     like a motion-curve problem and was not one. `min-content` is not
     stretchable, so the row is the summary's height at every frame and the
     label, the caret and the plate's top edge do not move at all. Measured at
     0px of drift in all three engines, opening and closing.

     THE FADE IS DECLARED TWICE, and it has to be, because no single spelling of
     it runs in all three engines. Blink refuses to start a transition on an
     element that was being skipped for `content-visibility`, so the plain
     [open] swap never fires there and the text just appears; it honours
     @starting-style instead, which is the mechanism for exactly this case.
     Gecko and WebKit are the other way round — they run the [open] swap and
     ignore the @starting-style. The two never both fire in one engine, so the
     opacities cannot compound; whichever an engine ignores, its end state is
     the same `opacity: 1`. The fade is on the tile's CHILDREN rather than on
     ::details-content because Gecko does not apply opacity to that pseudo at
     all. */
  .prose :global(.citation) {
    --citation-dur: 0.4s;
    --citation-ease: ease-in-out;
  }

  @supports selector(::details-content) {
    .prose :global(.citation) {
      display: grid;
      grid-template-rows: min-content 0fr;
      transition: grid-template-rows var(--citation-dur) var(--citation-ease);
    }

    .prose :global(.citation[open]) {
      grid-template-rows: min-content 1fr;
    }

    /* `content-visibility` transitioned `allow-discrete` alongside the track,
       because a closed <details> hides its content with content-visibility and
       it would otherwise vanish in the first frame of the close rather than
       slide away. Blink is currently the only engine that honours this. */
    .prose :global(.citation::details-content) {
      min-block-size: 0;
      overflow: hidden;
      transition: content-visibility var(--citation-dur) allow-discrete;
    }

    .prose :global(.citation > :not(summary)) {
      opacity: 0;
      transition: opacity var(--citation-dur) var(--citation-ease);
    }

    .prose :global(.citation[open] > :not(summary)) {
      opacity: 1;
    }

    /* `:not(.citation--open)` EXEMPTS A TILE THAT WAS ALREADY OPEN AT FIRST
       PAINT. @starting-style fires on an element's first render as well as on a
       state change, so without this the References list at the foot of the
       guide — the one tile that ships with the `open` attribute, see the `+`
       marker in remark-citation.mjs — would fade itself up over 0.4s on load,
       for no reason and with nothing having been clicked. The fade belongs to
       the ACT of opening; a tile that starts open never performed it. */
    @starting-style {
      .prose :global(.citation[open]:not(.citation--open) > :not(summary)) {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .prose :global(.citation),
      .prose :global(.citation > :not(summary)) {
        transition: none;
      }
    }
  }

  /* The tile's padding is the tile's padding. Without this the last paragraph
     adds its own bottom margin inside the box and the plate sits visibly
     heavier at the bottom than at the top — the classic card-with-prose bug. */
  .prose :global(.citation > :last-child) {
    margin-bottom: 0;
  }

  /* A RUN OF THEM IS ONE STACK. Most of these arrive four at a time under a
     "Background" line, and at the full 1.5rem apart they read as four unrelated
     interruptions rather than as one apparatus block. Tightening the gap
     BETWEEN adjacent tiles — while keeping the full margin above the first and
     below the last — is what makes the group read as a single object with the
     prose resuming after it. */
  .prose :global(.citation + .citation) {
    margin-top: 0.5rem;
  }

  .prose :global(figure) {
    margin: 2rem 0;
  }

  .prose :global(figure img),
  .prose :global(p img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  /* ── Legacy figures drawn for a white page ────────────────────────────────
     The six diagrams in these posts date from 2016–2021, when jaan.io had a
     light background, and every one of them is pure black line art with no
     colour in it at all. Marked class="ink" per-image in the Markdown, so the
     photographs and screenshots in the same posts are untouched.

     They used to be given `background: #fff; padding: 1rem` — the white page
     they were drawn against, handed back to them. That works, and it looks
     like exactly what it is: six lit slabs down a black article, each one a
     rectangle of the old site left in the new one.

     Inverting instead makes them white ink on nothing, so they sit on the page
     rather than on a patch of a different page. It is only honest because
     there is no colour to damage: an inverted photograph is a negative, but an
     inverted black-on-transparent drawing is a white-on-transparent drawing,
     which is the same drawing.

     `invert(var(--figure-invert))` rather than a `:root[data-palette$="-light"]`
     rule here, because invert(0) is defined to be a no-op — so ONE declaration
     covers dark and light, and the palette decides by setting the number. The
     token is in tokens.css and the light override is in palettes.css.

     The three Ising SVGs also carried a full-bleed white <path> as a
     background, which would have inverted to a black rectangle — invisible on
     this site's #000 but a dark slab on any of the coloured dark palettes.
     Their background path is `fill:none` now, so all six are transparent and
     all six take whatever the page behind them is. */
  .prose :global(img.ink) {
    filter: invert(var(--figure-invert, 1));
  }

  .prose :global(figcaption) {
    margin-top: 0.625rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
  }

  /* Embedded interactive figures (YouTube, the D3/Plotly pages under /files/).
     The originals carry hardcoded width/height attributes from 2016. */
  /* ── Display math sits at the paragraph's size ────────────────────────────
     rehype-katex emits a display equation as a `.katex-display` span that is a
     DIRECT CHILD of .prose, not wrapped in a <p>. So it never saw the
     `font-size: var(--fs-body)` the <p> rule above sets, and inherited 16px
     from the root instead — while inline math, which IS inside a <p>, inherited
     24px. KaTeX then scales both by its own 1.21em, and the article ended up
     with display equations at 19.4px underneath inline equations at 29px: the
     centred, set-apart formula was the smallest maths on the page.

     Setting it here rather than putting a font-size on `.prose` itself, which
     would land on every descendant that does not set its own and change lists,
     captions, tables and figcaptions along with it. */
  .prose :global(.katex-display) {
    font-size: var(--fs-body);
  }

  .prose :global(iframe) {
    max-width: 100%;
    border: 0;
  }

  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.15em 0.35em;
    background: var(--surface);
  }

  .prose :global(pre) {
    background: var(--surface);
    padding: 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    line-height: 1.45;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--fs-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }

  /* ── Math ───────────────────────────────────────────────────────────────
     Display equations are the one element here that genuinely cannot wrap: a
     long line of LaTeX is one unbreakable box. Without its own scroller it
     widens the page and the whole article scrolls sideways on a phone. */
  .prose :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
    margin: 1.5rem 0;
  }

  /* KaTeX sizes rules (fraction bars, radicals, \overline) in ems that round
     to sub-pixel heights; on a near-black background those disappear at body
     size. Floor them so fractions still read as fractions. */
  .prose :global(.katex .frac-line),
  .prose :global(.katex .overline .overline-line),
  .prose :global(.katex .underline .underline-line) {
    min-height: 1px;
    border-bottom-width: max(1px, 0.04em);
  }

  /* ── Footnotes (16 of them in the physics post) ─────────────────────── */
  .prose :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .prose :global(.footnotes h2) {
    font-size: var(--fs-md);
    font-family: var(--font-body);
    margin-bottom: 0.75rem;
  }

  .prose :global(.footnotes p) {
    font-size: inherit;
    margin-bottom: 0.5rem;
  }

  /* The little ↩ backlink after each definition. */
  .prose :global(.data-footnote-backref) {
    text-decoration: none;
    margin-left: 0.25rem;
  }

  /* Superscript reference markers in the body text. */
  .prose :global(sup a) {
    text-decoration: none;
  }

  .prose-back {
    display: inline-block;
    margin-top: 1rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--text) 25%, transparent);
  }
  .prose-back:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }
  /* Focus ring comes from the global :focus-visible rule in base.css. */
</style>
