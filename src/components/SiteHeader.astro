---
interface Props {
  navMode?: "ticker" | "static";
}
import { SITE } from "../site.config";
import NavLink from "./NavLink.astro";
import { NAV_MORPH_SCRIPT } from "../lib/nav-morph";
// No ticker on this site — the scrolling stats bar and its data were a
// Community Cleanup feature. `navMode` is kept so the "compact" chrome style
// stays reachable, but "static" is the default here.
const { navMode = "static" } = Astro.props;
---

<!-- A <header>, not a <div>: this is the site's banner landmark, which screen
     reader users jump to directly. Every coordinating CSS selector matches on
     .site-chrome / #site-chrome, and MobileMenu stays a sibling, so the general-
     sibling rules (.site-chrome.is-fixed ~ …) are unaffected by the element swap. -->
<header class={`site-chrome ${navMode === "ticker" ? "compact" : "static-nav"}`} id="site-chrome">
  <!-- Nav: logo left + links right (hidden in compact mode) -->
  <nav class="nav" id="main-nav" aria-label="Site navigation">
    {
      /* A wordmark, plus — on phone widths only — the morphing portrait mark.
        SITE.features.navMorph is the switch; the reasoning is on it. */
    }
    <a
      href="/"
      class:list={["nav-home", SITE.features.navMorph && "has-mark"]}
      aria-label={`${SITE.name} — home`}
    >
      {
        SITE.features.navMorph && (
          <>
            <picture>
              {/* DESKTOP — an empty SVG, because there is no way to say
                  "download nothing" in a <picture>, and `display: none` on an
                  <img> does not reliably stop the fetch. Without this line every
                  desktop visitor pays for a mark that chrome.css hides. 1025px is
                  1024px+1: it must be the exact complement of the
                  @media (max-width: 1024px) block in chrome.css, or some width
                  gets both rules or neither. */}
              <source media="(min-width: 1025px)" srcset="/nav-blank.svg" />
              {/* The STILL composite is the markup default, and the morph is an
                  upgrade the script beside this applies — see src/lib/nav-morph.ts,
                  which explains why. Short version: the script has to fetch and
                  rewrite the morph anyway to start it on a random face, and
                  declining to do that is also how reduced motion is honoured,
                  since no stylesheet can reach SMIL inside an <img>. So this src
                  is what a visitor keeps with JS off, with reduced motion on, or
                  if the fetch fails. /nav-still.svg rather than /favicon.svg —
                  that one is blue under a light scheme and would sit at ~2.5:1 on
                  this black bar; see the note in scripts/gen-favicons.mjs. */}
              <img class="nav-morph" src="/nav-still.svg" alt="" width="36" height="36" />
            </picture>
            <script is:inline set:html={NAV_MORPH_SCRIPT} />
          </>
        )
      }
      <span class="nav-wordmark">{SITE.name}</span>
    </a>
    <div class="nav-links">
      {SITE.nav.header.map((link) => <NavLink link={link} class="nav-link" />)}
      {
        SITE.nav.headerCta && (
          <>
            <span class="nav-divider" aria-hidden="true" />
            <NavLink link={SITE.nav.headerCta} class="nav-btn" />
          </>
        )
      }
    </div>
  </nav>
</header><!-- /.site-chrome -->

<div id="chrome-spacer" aria-hidden="true"></div>

<script>
  // Site chrome behavior: fill the scrolling ticker and show/hide the nav on
  // scroll. Coordinates the (sibling) menu button by id, which MobileMenu renders.
  const chrome = document.getElementById("site-chrome")!;
  const isStaticNav = chrome.classList.contains("static-nav");
  const menuBtn = document.getElementById("nav-menu-btn");

  // ── Scroll behavior ─────────────────────────────────────────────
  if (isStaticNav) {
    // Static-nav pages: start visible, hide on scroll-down, reveal on scroll-up.
    let lastY = window.scrollY;
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const y = window.scrollY;
            if (y > lastY && y > 8) {
              chrome.classList.add("is-hidden");
              menuBtn?.classList.add("is-nav-hidden");
            } else if (y < lastY) {
              chrome.classList.remove("is-hidden");
              menuBtn?.classList.remove("is-nav-hidden");
            }
            lastY = y;
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );
  } else {
    // Ticker pages: compact in-flow at top → fixed+revealed on scroll-up past 25vh.
    const threshold = window.innerHeight * 0.25;
    let lastY = 0;
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const y = window.scrollY;
            const scrollingDown = y > lastY;
            const pastThreshold = y > threshold;

            if (!pastThreshold) {
              if (chrome.classList.contains("is-fixed") && !chrome.dataset.leaving) {
                // Leaving is-fixed → compact: slide button out with chrome.
                // CSS switches button back to sticky once compact class is restored.
                chrome.dataset.leaving = "1";
                menuBtn?.classList.add("is-nav-hidden");
                chrome.classList.remove("is-revealed");
                chrome.addEventListener(
                  "transitionend",
                  () => {
                    delete chrome.dataset.leaving;
                    if (!chrome.classList.contains("is-revealed")) {
                      chrome.classList.add("no-transition");
                      chrome.classList.remove("is-fixed");
                      chrome.classList.add("compact");
                      void chrome.offsetHeight;
                      chrome.classList.remove("no-transition");
                      menuBtn?.classList.remove("is-nav-hidden");
                    }
                  },
                  { once: true },
                );
              }
              // else: already compact — position: sticky handles everything, no JS needed.
            } else if (scrollingDown) {
              chrome.classList.remove("is-revealed");
              menuBtn?.classList.add("is-nav-hidden");
            } else {
              menuBtn?.classList.remove("is-nav-hidden");
              delete chrome.dataset.leaving;
              if (!chrome.classList.contains("is-fixed")) {
                chrome.classList.add("no-transition");
                chrome.classList.remove("compact");
                chrome.classList.add("is-fixed");
                void chrome.offsetHeight;
                chrome.classList.remove("no-transition");
              }
              chrome.classList.add("is-revealed");
            }

            lastY = y;
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
