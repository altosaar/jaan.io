---
// A fixed tag rail in the page's left gutter — the shape from
// config.figma.com/san-francisco/faq/: small boxes stacked down the left, on
// the raised-surface grey, aligned to the nav wordmark's left edge.
//
// TWO MODES, ONE RAIL. Pass exactly one of them.
//
//   const { Content, headings } = await render(post);
//   <Toc headings={headings} />          // a contents list that follows scroll
//
//   <Toc links={SITE.contact} label="Elsewhere" />   // an authored list
//
// The second exists so /about/'s contact rail is the SAME object as the
// articles' contents rail rather than a lookalike built beside it — one set of
// styles, one alignment, one breakpoint. Only the first has a current item,
// because only it has sections you can be inside.
//
// It renders nothing when there is nothing to navigate: fewer than two
// headings, or an empty link list.
//
// WHY IT IS `position: fixed` AND NOT `position: sticky`
// Sticky needs the element in the normal flow of something tall enough to
// scroll within, and the flow here is a centred --reading-w column: the rail
// belongs in the gutter OUTSIDE that column, aligned to the site chrome rather
// than to the text. Fixed positions against the viewport, which is exactly the
// coordinate system the nav uses, so the two line up by construction.
import type { MarkdownHeading } from "astro";
import type { SiteLink } from "../site.config";

interface Props {
  headings?: MarkdownHeading[];
  /** An authored rail. Mutually exclusive with `headings`. */
  links?: SiteLink[];
  /** Deepest heading level to list. h2 is the section level in these posts. */
  maxDepth?: number;
  /** Accessible name for the landmark. */
  label?: string;
}

const { headings, links, maxDepth = 3, label } = Astro.props;

if (headings && links) {
  throw new Error("[Toc] Pass `headings` or `links`, not both — they are two modes of one rail.");
}

// h1 is the post title, which is not a section of itself.
const items = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= maxDepth);

// A contents list of one is not worth a rail; an authored list of one is, since
// the author asked for exactly those.
const show = links ? links.length > 0 : items.length > 1;
const name = label ?? (links ? "Elsewhere" : "On this page");
---

{
  show && (
    <nav class="toc" aria-label={name}>
      <ol class="toc__list">
        {links
          ? links.map((link) => (
              <li class="toc__item">
                <a
                  class="toc__link"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          : items.map((h) => (
              <li class:list={["toc__item", `toc__item--d${h.depth}`]}>
                <a class="toc__link" href={`#${h.slug}`} data-toc-link={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    position: fixed;
    /* The left edge lands on the nav wordmark's left edge. The nav is
       `width: var(--site-w)` centred with auto margins inside a fixed, full-ICB
       header, so its left edge sits at (ICB − 94vw) / 2. For a fixed element,
       `100%` IS the ICB, so this is the same number arrived at the same way —
       including when a classic scrollbar is taking width off the ICB, which a
       plain `3vw` would get wrong by half the scrollbar. --chrome-w, not
       --site-w: inside main.is-centered the latter is the ~680px reading
       measure. */
    left: calc((100% - var(--chrome-w)) / 2);

    /* Centred on the viewport's vertical midpoint: pin both edges, give the box
       its content height, and let the auto margins split what is left over.
       That is the abspos centring rule, and it beats `top: 50%` +
       `translateY(-50%)` here — a translate of half an odd-numbered height
       lands the box on a half-pixel and softens 13px text. This way the box
       stays on whole pixels. */
    top: 0;
    bottom: 0;
    height: max-content;
    margin-block: auto;

    /* The cap is what keeps centring safe. The rail has to survive the physics
       post's twenty-two headings on a short laptop screen, and at full height a
       centred box would slide up under the fixed nav. Subtracting twice the nav
       plus a rem means that even when the cap binds, the top edge lands exactly
       one rem below the nav — the same clearance the headings' scroll-margin
       uses — and the bottom edge mirrors it. Past that it scrolls itself. */
    max-height: calc(100svh - 2 * (var(--nav-h) + 1rem));
    overflow-y: auto;
    overscroll-behavior: contain;

    /* Room for the widest tag, bounded so a long heading cannot reach the text
       column. See the media query below for where this stops fitting at all. */
    width: min(15rem, calc((100vw - var(--reading-w)) / 2 - var(--edge) - 2rem));

    /* Above the page, below the mobile menu (300) and its button (400). */
    z-index: 40;

    /* --- Ribbon choreography (see the block below the link styles) ---------
       --n is the tag count, written once by the script. The stagger is the gap
       between one tag setting off and the next; 36ms is the figure that reads
       as a ribbon rather than a queue, but a twenty-two-heading post would
       spend most of a second just handing off, so it is also capped to fit the
       whole hand-off inside 180ms however many tags there are. */
    --n: 1;
    --toc-stagger: min(36ms, calc(180ms / var(--n)));

    /* Same duration and curve as the header (chrome.css) — the rail is not
       animating alongside the nav, it is animating WITH it. */
    transition:
      opacity var(--dur-slide) var(--ease-standard),
      transform var(--dur-slide) var(--ease-standard);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    /* Tight, like the reference: the stack should read as one object. */
    align-items: flex-start;
    gap: 0.25rem;
  }

  /* Nested headings step in, so the rail shows structure rather than a flat
     list. Only h3 can indent — maxDepth stops at 3 by default. */
  .toc__item--d3 {
    padding-left: 0.75rem;
  }

  .toc__link {
    display: inline-block;
    /* Navigation, so it takes the chrome voice rather than the content face —
       see the role tokens in tokens.css. */
    font-family: var(--font-chrome);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
    /* NOT uppercased, unlike the reference and unlike .nav-link. Those are
       one-word category labels; these are sentences ("Mean-field versus
       amortized inference"), and uppercasing them costs a line of wrapping
       each and reads as shouting. */
    color: var(--text);
    background: var(--surface);
    text-decoration: none;
    box-shadow: none;
    padding: 0.3rem 0.5rem;
    border-radius: var(--hover-radius);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .toc__link:hover,
  .toc__link:focus-visible {
    background: var(--accent);
    color: var(--bg);
    outline: none;
  }

  /* The section you are in. Light fill on dark, the same inversion .nav-btn
     uses, so "current" reads at a glance down a column of grey. Both pairs are
     covered by npm run a11y: --text on --surface is 11.23:1, --bg on
     --btn-light is 16.21:1. */
  .toc__link.is-current {
    background: var(--btn-light);
    color: var(--bg);
  }

  /* Hover still wins over current, so pointing at another section previews it. */
  .toc__link.is-current:hover,
  .toc__link.is-current:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  /* ── The ribbon ─────────────────────────────────────────────────────────
     Scrolling down puts the header away (SiteHeader.astro sets .is-nav-hidden
     on <html>); the rail goes with it, and the way it goes is the whole point.

     Each tag slides up onto the one above it — bottom tag first, then the next,
     on up the column, so the stack closes like a fan and not like a lift door.
     Reversed paint order is what makes them slide UNDER rather than over:
     without it, document order puts the LAST tag on top and the collapse looks
     like a pile-on. Then the closed deck, which is now just the top tag, fades.
     Scrolling up runs the identical motion with the stagger reversed, so the
     deck spreads from the top down.

     Two numbers do all of it, both written per-tag by the script: --i (the
     tag's place in the column) and --dy (how far that tag has to travel to land
     on the first one). Tags are not a uniform height — a two-line heading is
     taller than a one-line one — so a single repeated step would leave the
     closed stack ragged. Each tag carries its own measurement.

     With the script absent or the geometry unmeasured, --dy is 0 and the rail
     simply fades. Nothing about this is load-bearing for reading the page. */
  .toc__item {
    position: relative;
    z-index: calc(var(--n) - var(--i, 0));
    transition: transform var(--dur-slide) var(--ease-standard);
    /* Spreading: the top tag leads and the rest follow it down the column. */
    transition-delay: calc(var(--i, 0) * var(--toc-stagger));
  }

  :global(html.is-nav-hidden) .toc__item {
    transform: translateY(calc(-1 * var(--dy, 0px)));
    /* Closing: the exact inverse — the bottom tag leads and the rest follow it
       up. Same rate, same curve; only the order of departure changes. */
    transition-delay: calc((var(--n) - 1 - var(--i, 0)) * var(--toc-stagger));
  }

  :global(html.is-nav-hidden) .toc {
    opacity: 0;
    /* A last lift as it goes, echoing the header's own exit. */
    transform: translateY(-0.75rem);
    /* Invisible, so it must stop swallowing clicks in the left gutter. */
    pointer-events: none;
    /* "and then the top one disappears": the deck holds until the tags have
       finished closing into it, and only then goes. Coming back it leads —
       the base rule above carries no delay — so the deck reappears and then
       spreads. */
    transition-delay: calc((var(--n) - 1) * var(--toc-stagger));
  }

  /* Keyboard escape hatch. The rail stays in the tab order while it is closed
     (hiding it would mean the outline is reachable only by mouse-scrolling up),
     so tabbing into it has to bring it back — otherwise focus lands on an
     invisible link. :focus-within re-runs the spread exactly as scrolling up
     would, which is also how it reads: the ribbon opens to meet you. */
  :global(html.is-nav-hidden) .toc:focus-within {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition-delay: 0ms;
  }

  :global(html.is-nav-hidden) .toc:focus-within .toc__item {
    transform: none;
    transition-delay: calc(var(--i, 0) * var(--toc-stagger));
  }

  /* Below this the gutter cannot hold the rail without crowding the measure.
     The text column is --reading-w (850px) and centred, so each gutter is
     (100vw − 850) / 2, from which the rail still owes an --edge and a 2rem gap:

       1400px → (1400−850)/2 − 48 − 32 = 195px   readable
       1300px → (1300−850)/2 − 48 − 32 = 145px   too narrow to set a heading in

     This threshold moved out from 1200px when the measure was widened 25% —
     a wider column is a narrower gutter, and the rail pays for it. Hidden
     rather than reflowed inline; see the note in the report. */
  @media (max-width: 1400px) {
    .toc {
      display: none;
    }
  }

  /* The rail is a scroll-following affordance; honouring reduced-motion here
     means not animating the fill as it moves between items, and — far more
     to the point — not sliding eight boxes across the screen every time the
     page moves. The rail still leaves with the header, it just cuts.

     0.01ms rather than `transition: none`, matching the house rule in
     chrome.css: a transition that never runs never fires transitionend, and
     the chrome's own scroll script depends on that event. Nothing here listens
     for it, but a rail that animates by a different mechanism than the header
     it is synchronised to is a trap for whoever edits this next. */
  @media (prefers-reduced-motion: reduce) {
    .toc__link {
      transition: none;
    }

    .toc,
    .toc__item,
    :global(html.is-nav-hidden) .toc,
    :global(html.is-nav-hidden) .toc__item,
    :global(html.is-nav-hidden) .toc:focus-within,
    :global(html.is-nav-hidden) .toc:focus-within .toc__item {
      transition-duration: 0.01ms;
      transition-delay: 0ms;
    }

    :global(html.is-nav-hidden) .toc {
      transform: none;
    }

    :global(html.is-nav-hidden) .toc__item {
      transform: none;
    }
  }
</style>

<script>
  // Which heading you are currently under.
  //
  // Deliberately a scroll handler and not an IntersectionObserver: IO answers
  // "is this element in a band", which leaves a section taller than the band
  // with no answer at all, and two short ones fighting over it. The question a
  // table of contents actually asks is "which heading did I last pass", and
  // that is a scan for the last one above a line — always exactly one answer,
  // for any section length, and correct after a jump-link or a page restore
  // rather than only after the next intersection.
  const rail = document.querySelector<HTMLElement>(".toc");
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of rail?.querySelectorAll<HTMLAnchorElement>("[data-toc-link]") ?? []) {
    links.set(a.dataset.tocLink!, a);
  }

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // ── Ribbon geometry ────────────────────────────────────────────────────
  // The collapse itself is entirely in CSS. All it wants from here are three
  // numbers per layout: how many tags there are, where each one sits in the
  // column, and how far it has to travel to land on the first one.
  //
  // Measured rather than assumed, because tag heights are not uniform: a
  // heading that wraps to two lines is taller than one that does not, and a
  // single repeated step would leave the closed stack ragged by however many
  // pixels the wrapping added.
  //
  // Runs for both modes of the rail — /about/'s contact list closes the same
  // way, on the rare screen short enough for that page to scroll at all.
  const list = rail?.querySelector<HTMLElement>(".toc__list");
  if (rail && list) {
    const items = [...list.querySelectorAll<HTMLElement>(".toc__item")];
    rail.style.setProperty("--n", String(items.length));

    const measure = () => {
      // Distances are ACCUMULATED from heights and the flex gap rather than
      // read off positions, and that is not a stylistic choice:
      //
      //   · offsetTop rounds to whole pixels. Tags are 31.15px apart here, so
      //     a rounded offset leaves each tag up to half a pixel out and the
      //     closed stack shows a hairline of every tag behind the top one.
      //   · getBoundingClientRect() has the subpixel precision but reports the
      //     TRANSFORMED position — it would measure the collapse it is feeding,
      //     which is circular the moment anything re-measures mid-animation.
      //
      // A height and a gap are subpixel-exact AND untouched by a translate, so
      // summing them is both precise and safe to re-run at any moment.
      const gap = parseFloat(getComputedStyle(list).rowGap) || 0;
      let dy = 0;
      for (const [i, el] of items.entries()) {
        el.style.setProperty("--i", String(i));
        el.style.setProperty("--dy", `${dy}px`);
        dy += el.getBoundingClientRect().height + gap;
      }
    };

    measure();
    // Catches the three things that move these numbers: the viewport resizing,
    // the webfont swapping in under the fallback, and a heading rewrapping
    // because of either. Observing the rail is enough — all three change its
    // own box. Transforms do not, so this cannot feed itself.
    new ResizeObserver(measure).observe(rail);
  }

  // Nothing to spy on in `links` mode — an authored rail has no sections to be
  // "in" — so bail before attaching any listeners rather than running a scan
  // that can only ever return nothing.
  if (rail && targets.length > 0) {
    // The line a heading has to cross to count as "reached".
    //
    // It must sit at or BELOW where a jump-link parks a heading, which is
    // `scroll-margin-top: nav + 1rem` (Prose.astro). Set it above that and
    // clicking a tag scrolls its heading to a spot the line has not reached, so
    // the rail lights the PREVIOUS tag — an off-by-one that looks like the spy
    // lagging rather than like a mismatched constant. Half a rem of slack
    // absorbs subpixel rounding at that landing position.
    const rootFs = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const navRem = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue("--nav-h"),
    );
    const navPx = Number.isFinite(navRem) ? navRem * rootFs : 56;
    const line = navPx + rootFs * 1.5;

    let current: HTMLAnchorElement | null = null;
    const setCurrent = (next: HTMLAnchorElement | null) => {
      if (next === current) return;
      current?.classList.remove("is-current");
      current?.removeAttribute("aria-current");
      next?.classList.add("is-current");
      // "true" rather than "location": the rail is not a set of page links, it
      // points within this one.
      next?.setAttribute("aria-current", "true");
      current = next;
    };

    // Keep the highlight visible when the rail is scrolling itself — the
    // physics post has twenty-one tags and at 1600×900 they overflow the rail
    // by 200px, so the current one can be off-rail.
    //
    // Called from update() rather than from setCurrent() because it has to run
    // on two occasions, not one: when the current section changes, and when the
    // ribbon re-opens. Skipping it while the ribbon is closed is the point of
    // the first check — every tag is stacked on the first one then, so
    // scrollIntoView would drag the rail to the top and leave it there, and the
    // rail would re-open showing its first tag rather than the section you are
    // actually in. Deferring instead means the very next scroll frame after it
    // re-opens puts it right.
    const revealCurrent = () => {
      if (!current || document.documentElement.classList.contains("is-nav-hidden")) return;
      if (rail.scrollHeight <= rail.clientHeight) return;
      const r = current.getBoundingClientRect();
      const box = rail.getBoundingClientRect();
      if (r.top < box.top || r.bottom > box.bottom) {
        current.scrollIntoView({ block: "nearest" });
      }
    };

    const update = () => {
      let passed: HTMLElement | null = null;
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) passed = t;
        else break; // targets are in document order, so the first miss ends it
      }
      // Before the first heading you are still in the opening paragraphs. Fall
      // back to the first item so the rail is never entirely unlit.
      const id = (passed ?? targets[0])?.id;
      setCurrent(id ? (links.get(id) ?? null) : null);
      revealCurrent();
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  }
</script>
