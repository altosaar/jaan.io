---
// /newsletter/ — the signup card on its own, for linking to directly.
import Base from "../layouts/Base.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<Base title="Newsletter" description="Sign up for the jaan.io newsletter.">
  <h1 class="sr-only">Newsletter</h1>
  <div class="newsletter-page">
    <NewsletterSignup>
      <p class="newsletter-page__note">A few times a year. Unsubscribe anytime.</p>
    </NewsletterSignup>
  </div>
</Base>

<style>
  /* Centred on the viewport the same way /about/ is — see .about there for why
     it is 100svh minus the nav with a nav's worth of padding underneath. */
  .newsletter-page {
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: var(--nav-h);
  }

  /* The card's own section spacing would push it off the midpoint. */
  .newsletter-page :global(.newsletter) {
    padding-top: 0;
    margin-bottom: 0;
  }

  .newsletter-page__note {
    margin-bottom: 1rem;
    text-align: center;
    font-size: var(--fs-body);
    color: var(--text-muted);
  }
</style>
