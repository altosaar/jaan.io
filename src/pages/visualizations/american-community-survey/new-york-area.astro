---
// Was jaan.li/american-community-survey/new-york-area.
import Viz from "../../../layouts/Viz.astro";
import VizEmbed from "../../../components/VizEmbed.astro";
---

<Viz
  title="New York incomes by area and sector"
  description="Income by sector of employment for any public use microdata area in the New York–Newark–Jersey City statistical area, in any year since 2005."
  eyebrow="American Community Survey"
  eyebrowHref="/visualizations/american-community-survey"
>
  <h2 class="viz-h2">The sectors where people earn most shift across time and space</h2>
  <p class="viz-note">
    15 million people's answers to the 2005–2022 surveys, restricted to the public use microdata
    areas that overlap the New York–Newark–Jersey City core-based statistical area as drawn in 2020.
    Pick an area and drag the year; two neighbourhoods a mile apart can look nothing alike.
  </p>
  <p class="viz-note">
    2020 is missing from the range on purpose — the Census Bureau did not release a standard
    one-year public use microdata sample for that year.
  </p>

  <VizEmbed module="acs-new-york" export="IncomeBySectorNewYork" minHeight={560} />

  <Fragment slot="sources">
    <ul>
      <li>
        Data: <a href="https://www.census.gov/programs-surveys/acs/data.html" rel="noopener"
          >American Community Survey</a
        >, U.S. Census Bureau, 2005–2022 public use microdata samples, inflation-adjusted.
      </li>
      <li>
        Transform: <a
          href="https://github.com/jaanli/exploring_american_community_survey_data/blob/main/american_community_survey/models/public_use_microdata_sample/figures/income-histogram-with-sector-historical-inflation-adjusted-industry-mapped-newyork-newark-cbsa.sql"
          rel="noopener">income-histogram-with-sector-historical-…-newyork-newark-cbsa.sql</a
        >.
      </li>
    </ul>
  </Fragment>
</Viz>
