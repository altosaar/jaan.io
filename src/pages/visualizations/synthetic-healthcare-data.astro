---
// Was jaan.li/synthetic-healthcare-data.
import Viz from "../../layouts/Viz.astro";
import VizEmbed from "../../components/VizEmbed.astro";
---

<Viz
  title="Synthetic healthcare data"
  description="What an inpatient claim gets paid, and how far that differs between commercial insurance, Medicaid and Medicare, across 1.2 million people."
  eyebrow="Visualizations"
  eyebrowHref="/visualizations"
>
  <h2 class="viz-h2">Payment distributions vary by insurance type</h2>
  <p class="viz-note">
    The amount paid per claim for the inpatient care of 1.2 million people in 2016, representing
    $8.6 billion in health care costs, stated in 2022 dollars. The underlying dataset is synthetic —
    generated by the Agency for Healthcare Research and Quality to match the statistical shape of
    real discharge records without describing any real patient.
  </p>

  <VizEmbed module="synthetic-healthcare-data" export="PaymentChart" minHeight={520} />

  <p class="viz-note">
    Ideas welcome. The next questions are large language models and algorithmic fairness metrics in
    health care settings; email <a href="mailto:hello@onefact.org">hello@onefact.org</a> to work on them.
  </p>

  <Fragment slot="sources">
    <ul>
      <li>
        Data: <a
          href="https://www.ahrq.gov/sites/default/files/wysiwyg/data/SyH-DR-Codebook.pdf"
          rel="noopener">AHRQ Synthetic Healthcare Database for Research codebook</a
        >, Agency for Healthcare Research and Quality, U.S. Department of Health and Human Services.
      </li>
      <li>
        Transform: <a
          href="https://github.com/onefact/synthetic-healthcare-data/blob/87c63a9d826c5ce8950c7257db19b4c809a650dd/data_processing/models/figures/insurance_plan_payment_histogram_inflation_adjusted.sql"
          rel="noopener">insurance_plan_payment_histogram_inflation_adjusted.sql</a
        > in <a href="https://github.com/onefact/synthetic-healthcare-data" rel="noopener"
          >onefact/synthetic-healthcare-data</a
        >.
      </li>
    </ul>
  </Fragment>
</Viz>
