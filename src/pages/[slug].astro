---
// Blog posts, at the exact URLs jaan.io has served since 2013.
//
// The Jekyll site used `permalink: /:title/`, where :title is the filename slug
// with the leading YYYY-MM-DD- stripped. So `src/content/posts/<slug>.md` →
// `/<slug>/`, and with trailingSlash:"always" + build.format:"directory" in
// astro.config.mjs the emitted path is `<slug>/index.html` — byte-identical to
// the live URL. Renaming a file here breaks a URL that carries real search
// traffic; add a redirect instead.
//
// A single [slug] (not [...slug]) is deliberate: every post URL is exactly one
// path segment, so this route cannot accidentally shadow a nested page later.
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import Toc from "../components/Toc.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
// KaTeX's stylesheet is imported here, not in Base.astro, so it only ships on
// routes that can contain math.
import "katex/dist/katex.min.css";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  {
    /* Before the article in DOM order so a screen reader meets the outline
       first, and inside its own labelled <nav> landmark so anyone who does not
       want twenty links can skip past it in one move. */
  }
  <Toc headings={headings} />

  <Prose>
    <h1>{post.data.title}</h1>
    {
      /* The dateline: under the headline, above the first paragraph, which is
         where a reader of anything already looks for it.

         The YEAR alone is shown, but `datetime` carries the whole date. That
         split is the point of the element — a person gets the resolution that
         is useful to them (2016 places the piece; the 18th of July does not),
         and a machine still gets the exact day for sorting, feeds and rich
         results. Written out rather than derived from the visible text,
         because the visible text is deliberately lossy. */
    }
    <p class="prose-dateline">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.getUTCFullYear()}
      </time>
    </p>
    <Content />
  </Prose>

  {
    /* After the article, never before it — the same reasoning as on /articles:
       someone who has read to the end has already decided whether the writing
       is for them, and a form in front of the piece asks before it shows.
       It sizes itself with the same three lines as <Prose> (width: --site-w,
       margin-left: --site-ml, max-width: --reading-w), so the box hangs off the
       article's own left edge and ends where its text column ends.

       This is what puts Turnstile's loader — the one third-party script on the
       site — on every post page rather than on the two pages that carried the
       form before. That is the cost of the form being here at all; nothing
       else about a post page changes, and the widget itself draws nothing (see
       the note beside it in NewsletterSignup.astro). */
  }
  <NewsletterSignup />
</Base>
