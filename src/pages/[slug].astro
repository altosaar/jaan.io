---
// Blog posts, at the exact URLs jaan.io has served since 2013.
//
// The Jekyll site used `permalink: /:title/`, where :title is the filename slug
// with the leading YYYY-MM-DD- stripped. So `src/content/posts/<slug>.md` →
// `/<slug>/`, and with trailingSlash:"always" + build.format:"directory" in
// astro.config.mjs the emitted path is `<slug>/index.html` — byte-identical to
// the live URL. Renaming a file here breaks a URL that carries real search
// traffic; add a redirect instead.
//
// A single [slug] (not [...slug]) is deliberate: every post URL is exactly one
// path segment, so this route cannot accidentally shadow a nested page later.
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import Toc from "../components/Toc.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
// KaTeX's stylesheet is imported here, not in Base.astro, so it only ships on
// routes that can contain math.
import "katex/dist/katex.min.css";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  {
    /* Before the article in DOM order so a screen reader meets the outline
       first, and inside its own labelled <nav> landmark so anyone who does not
       want twenty links can skip past it in one move. */
  }
  <Toc headings={headings} />

  {
    /* No date line. `date` is still in the frontmatter and still orders the
       list on /articles, where it is shown — but over the article itself a
       2016 stamp reads as a warning about the writing rather than a fact about
       it, and these posts are the opposite of stale: they are what most of the
       site's search traffic arrives for. The old Jekyll layout had reached the
       same conclusion and commented its date line out. */
  }
  <Prose>
    <h1>{post.data.title}</h1>
    <Content />
  </Prose>
</Base>
