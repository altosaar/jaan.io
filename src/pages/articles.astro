---
// /articles/ — the index of blog posts, newest first.
//
// NOTE ON THE URL: the Jekyll site's index lived at /blog/ and is still live
// today. This page is at /articles/ because that is what the nav calls it (and
// it matches the posts' own `category: articles` in the old frontmatter), so
// /blog/ needs a 301 → /articles/ before any DNS cutover. See the plan's
// Phase 4. The individual POST urls are unchanged and must stay that way.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const year = (d: Date) => d.getUTCFullYear();
---

<Base
  title="Articles"
  description="Long-form writing on machine learning, variational inference, physics, and the incentives behind the technology industry."
>
  <Section as="header" top="section" bottom="block">
    <!-- <h1>Articles</h1> -->
    <!-- <p class="articles-intro">
      Long-form writing, mostly on machine learning and physics. Older pieces are kept at their
      original URLs.
    </p> -->
  </Section>

  <Section bottom="gap">
    <ul class="articles" role="list">
      {
        posts.map((post) => (
          <li class="article">
            {post.data.thumb && (
              /* alt="" on purpose: the mark restates the headline sitting
                 beside it, so naming it would make a screen reader announce
                 every post twice. Decorative, and marked as such. */
              <Image class="article__mark" src={post.data.thumb} alt="" width={160} height={160} />
            )}
            <div class="article__body">
              <a href={`/${post.id}`} class="article__link">
                <h2 class="article__title">{post.data.title}</h2>
              </a>
              <div class="article__note">
                <p class="article__meta">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {year(post.data.date)}
                  </time>
                </p>
                <p class="article__desc">{post.data.description}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>

<style>
  .articles-intro {
    font-size: var(--fs-md);
    line-height: 1.6;
    max-width: var(--reading-w-tight);
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .articles {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--reading-w);

    /* No rules between entries. With only a handful of posts the list does not
       need dividing — each entry is already a mark, a headline, a year and a
       line of description, which is shape enough to read as one block. The
       rules were doing the separating that white space can do on its own, and
       four hairlines across the measure were the loudest thing on a page whose
       whole point is three headlines.
       Which means the space has to carry it, so there is a lot more of it.
       Entries used to be held apart by 1.5rem of padding from each neighbour,
       3rem between them; this is that raised by half twice over. At three
       posts on a tall screen it reads as deliberate rather than as a list —
       which is the right call at this length, and the thing to revisit if the
       remaining eleven posts ever land, since twelve entries 108px apart is a
       page you scroll rather than one you scan. One `gap` rather than padding
       on both sides so the number in the file IS the gap on screen, instead of
       half of it. */
    display: flex;
    flex-direction: column;
    gap: 6.75rem;
  }

  .article {
    /* Mark on the left, text on the right — the arrangement from the Jekyll
       blog index, which floated a 160px thumb beside the entry. Flex rather
       than a float so the text block cannot wrap underneath the mark on a
       narrow screen and leave it stranded in the margin. */
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .article__body {
    /* Without this a long unbroken title (or a URL in a description) sets the
       flex item's minimum width and pushes the row wider than the measure. */
    min-width: 0;
  }

  /* The marks are line art drawn in BLACK on transparency, for a page that used
     to be #f9f9f9. Dropped onto this one unchanged they render as nothing at
     all — the same trap the legacy figures fall into inside posts, which
     Prose.astro answers with a white plate behind the artwork.
     A plate is wrong here: a row of white discs down a dark list would shout
     louder than the headlines they belong to. Inverting is the better answer
     for line art with no colour in it — pure black becomes pure white and the
     transparency is untouched, so the drawing survives exactly, just in
     reverse. Toned to sit at the text's brightness rather than above it, since
     the mark is an aid to scanning and not the point of the row. */
  .article__mark {
    flex: none;
    width: clamp(3.25rem, 7vw, 5rem);
    height: auto;
    filter: invert(1);
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* Lights up with the headline it belongs to, so the row reads as one object
     under the pointer rather than as an icon and a link that happen to be
     adjacent. */
  .article:hover .article__mark {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .article__mark {
      transition: none;
    }
  }

  /* The heading is the link, so the whole title is one tap target. The
     underline treatment comes from the title rather than the anchor so the
     hover affordance covers the full line. */
  .article__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .article__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .article__link:hover .article__title,
  .article__link:focus-visible .article__title {
    color: var(--accent);
  }

  /* The year and the description share a line, the year leading it.
     This is the wrapper the previous arrangement did not need and this one
     does: it is not carrying spacing, it is establishing the relationship
     between two boxes side by side. Spacing alone cannot express "beside".

     `align-items: baseline` is the whole trick. The year is --fs-sm and the
     description --fs-body with a 1.6 line-height, so aligning the BOXES
     (stretch, or flex-start) would hang the year off the top of a taller line
     and the two would only be on the same row, not on the same line. Baselines
     put the digits and the first letter on one line of type, which is what
     "on the same line" means to a reader.

     The measure moves up here from .article__desc. The line now starts at the
     year, so the year is part of what has to stay inside a readable length —
     bounding the description alone would let the row run past it by however
     wide the year is.

     Wrapped lines return to the description's own left edge, not to the year's,
     because the description is a block in a row rather than text flowing
     around an inline. That is the wanted behaviour: the year introduces the
     sentence once, and every line after it lines up under the first. */
  .article__note {
    margin-top: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: var(--reading-w-tight);
  }

  .article__meta {
    /* Never let the year wrap or be squeezed — it is four characters and it
       sets where the description begins. */
    flex: none;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .article__desc {
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  /* Below this the row costs more than it says. The mark and the year together
     take a third of a phone's width off the description, which drops it to
     around thirty characters a line — a measure that hyphenates badly and
     reads as a column of fragments. Stacking gives the sentence its width
     back; the year still introduces it, just from above. */
  @media (max-width: 40rem) {
    .article__note {
      display: block;
    }

    .article__desc {
      margin-top: 0.25rem;
    }
  }
</style>
