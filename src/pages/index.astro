---
// The home page is one screen and nothing more: the headline, the portrait, and
// a single line of invitation. No footer, no scrolling, so the nav — which
// hides itself on scroll-down — is permanently visible.
//
// Only two type treatments exist on this page, deliberately:
//   • the display h1 (Fraunces, --fs-hero)
//   • everything else — the nav links and the one sentence — at --fs-md/350
import Base from "../layouts/Base.astro";
import PortraitBlink from "../components/PortraitBlink.astro";
import portraitOpen from "../assets/portrait-open.webp";
import portraitClosed from "../assets/portrait-closed.webp";
import { SITE } from "../site.config";
---

<Base
  title="Machine learning for health & science"
  description={SITE.description}
  fullscreen
  centered={false}
>
  {
    /* Not <Hero>: that component carries a fixed padding-top and margin-bottom
       sized for a scrolling page, which fights a composition centred in the
       viewport. The h1 treatment itself is unchanged — base.css styles every
       h1 in the display face, and the only override here is Hero's own
       font-size: var(--fs-hero). */
  }
  <div class="home">
    <h1 class="home__title">Large language models for health.</h1>

    <div class="home__intro">
      <div class="home__portrait">
        <PortraitBlink
          open={portraitOpen}
          closed={portraitClosed}
          alt="Jaan Altosaar, smiling in a floral shirt against blurred greenery."
        />
      </div>
      <p class="home__contact">
        <a href="mailto:j@jaan.io?subject=Inquiry">Get in touch</a> if you want to discuss an idea or
        grab a coffee. I'm available; let's bring it off.
      </p>
    </div>
  </div>
</Base>

<style>
  /* Fills the height <main> was given (see html.is-fullscreen in base.css) and
     centres its contents in it, so the composition sits in the middle of the
     screen rather than hanging from under the nav. */
  .home {
    width: var(--site-w);
    margin-left: var(--site-ml);
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* The site's vertical rhythm is viewport-WIDTH based, which is the right
       default for a page that can scroll. This one can't, so its rhythm has to
       yield on a short viewport too — a landscape phone is 390px tall, and
       --space-block alone would spend a quarter of that on gaps. Capped at the
       token, so nothing here is ever looser than the rest of the site. */
    gap: clamp(1rem, 4svh, var(--space-block));
    padding-block: clamp(1rem, 4svh, var(--space-block));

    /* The portrait is the one block here that cannot reflow, so on a short
       viewport it is what overflows first — and this page has no scrollbar to
       recover with. Hence a HEIGHT cap alongside the width one: 0.982 is the
       frames' aspect ratio (1571×1600), so `svh × ratio` is the width at which
       the portrait is exactly that many svh tall. Capping height directly
       instead would leave the box wider than the image and crop the face, since
       the frames are object-fit: cover.

       Declared once, here, because BOTH the element and the two-column grid
       track below need it. Sizing that track `auto` looked right and wasn't:
       an auto track takes its width from the image's 320px intrinsic size, not
       from the width this expression actually resolves to, so on a short
       viewport the track stayed 320px wide around a 120px portrait and opened
       a 200px hole between the portrait and the sentence. */
    --portrait-w: min(100%, 320px, 32svh * 0.982);
  }

  /* The svh term is the landscape-phone case: --fs-hero is width-driven, and
     844px of width asks for the full 6rem on a viewport only 390px tall. */
  .home__title {
    font-size: min(var(--fs-hero), 12svh);
  }

  /* Portrait immediately left of the line. One column on small screens, two
     once there is room for the text to keep a readable measure beside it. */
  .home__intro {
    display: grid;
    gap: clamp(1rem, 4svh, var(--space-gap));
    align-items: center;
    min-height: 0;
  }

  @media (min-width: 720px) {
    .home__intro {
      grid-template-columns: var(--portrait-w) minmax(0, 1fr);
    }
  }

  /* Square corners are deliberate site-wide — see --hover-radius in tokens.css.
     The border lives here; PortraitBlink clips its own frames to the box. */
  .home__portrait {
    width: var(--portrait-w);
    border: 1px solid var(--line);
  }

  /* Identical in size and weight to .nav-link (chrome.css) — the two are meant
     to read as one voice. Not `text-transform: uppercase` though: the nav is a
     set of labels, this is a sentence. */
  .home__contact {
    font-size: var(--fs-md);
    font-weight: 350;
    line-height: 1.6;
    /* rem, not ch: a `ch` measure resolves against the element's own font-size,
       which is easy to get wrong when the size is a variable. */
    max-width: 30rem;
  }
</style>
