---
import Base from "../layouts/Base.astro";
import PortraitBlink from "../components/PortraitBlink.astro";
import Carousel from "../components/Carousel.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import type { CarouselItem } from "../components/carousel.types";
import { FEATURED_ARTICLES } from "../data/featured-articles";
import { getCollection } from "astro:content";
import portraitOpen from "../assets/portrait-open.webp";
import portraitClosed from "../assets/portrait-closed.webp";
import { SITE } from "../site.config";

// Carousel items come from src/content/gallery/*.md (see src/content.config.ts).
// The image() schema validates every photo at build time, so a missing or
// misnamed image fails the build loudly — no hand-rolled checks needed.
//
// Unlike the template this design came from, these items carry no Markdown body:
// the carousel runs with enablePopup={false}, so there is no reveal panel for a
// body to fill. Photographs here stand on their own.
const gallery = await getCollection("gallery");
const entries = gallery.sort((a, b) => a.data.order - b.data.order);

const items: CarouselItem[] = entries.map((entry) => ({
  img: entry.data.image,
  alt: entry.data.alt,
  title: entry.data.title,
  caption: entry.data.caption,
  focusPosition: entry.data.focusPosition,
}));

// Resolve the hand-picked home page articles (src/data/featured-articles.ts)
// against the real collection. Titles and URLs come from the posts themselves so
// they can never drift from the article; only the blurb is authored separately.
//
// An unmatched slug throws rather than rendering a card pointing at nothing —
// the same "fail the build loudly" stance the gallery's image() schema takes.
const posts = await getCollection("posts");
const featured = FEATURED_ARTICLES.map(({ slug, blurb }) => {
  const post = posts.find((p) => p.id === slug);
  if (!post) {
    throw new Error(
      `[featured-articles] No post matches the slug "${slug}". ` +
        `Available: ${posts.map((p) => p.id).join(", ")}`,
    );
  }
  return { href: `/${post.id}/`, title: post.data.title, blurb };
});
---

<Base title="Machine learning for health & science" description={SITE.description}>
  <Hero title="Large language models for health." />

  {
    /* The portrait and the opening lines are one unit, so they are laid out here
       rather than through Hero's body slot: Astro's scoped styles don't cross
       component boundaries, and this two-column arrangement needs to style both
       the image and the text. The type sizes below are Hero's body treatment,
       carried over so the voice of the page is unchanged by the move. */
  }
  <Section bottom="gap">
    <div class="intro">
      <div class="intro__portrait">
        <PortraitBlink
          open={portraitOpen}
          closed={portraitClosed}
          alt="Jaan Altosaar, smiling in a floral shirt against blurred greenery."
        />
      </div>
      <div class="intro__text">
        <p class="intro__lead">Data Science and &amp; machine learning for health care.</p>
        <p class="intro__contact">
          <a href="mailto:j@jaan.io?subject=Inquiry">Get in touch</a> if you want to discuss an idea or
          grab a coffee. I'm available; let's bring it off.
        </p>
      </div>
    </div>
  </Section>

  <Section labelledby="articles-label" bottom="gap">
    <SectionHeading id="articles-label">Articles</SectionHeading>
    {
      /* Columns follow the number configured, so adding a fourth featured
         article widens the grid rather than leaving a gap. FeatureGrid collapses
         to one column below 760px regardless. */
    }
    <FeatureGrid columns={featured.length}>
      {
        featured.map((article) => (
          <div>
            <h3>
              <a href={article.href} class="featured__link">
                {article.title}
              </a>
            </h3>
            <p>{article.blurb}</p>
          </div>
        ))
      }
    </FeatureGrid>
  </Section>

  <Carousel
    items={items}
    variant="natural"
    enablePopup={false}
    grayscale
    heading="Portraits"
    labels={{
      prev: "Previous photo",
      next: "Next photo",
      counter: "Photo {n} of {total}",
    }}
  />
</Base>

<style>
  /* Portrait immediately left of the opening lines. One column on small screens,
     two once there's room for the text to keep a readable measure beside a
     320px image. Centred rather than top-aligned: the text block is shorter
     than the portrait, and hanging it from the top leaves an obvious void. */
  .intro {
    display: grid;
    gap: var(--space-gap);
    align-items: center;
  }

  @media (min-width: 720px) {
    .intro {
      grid-template-columns: 320px minmax(0, 1fr);
    }
  }

  .intro__portrait {
    width: min(100%, 320px);
    /* Square corners are deliberate site-wide — see --hover-radius in tokens.css.
       The border lives here; PortraitBlink clips its own frames to the box. */
    border: 1px solid var(--line);
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* An absolute cap, not a `ch` measure: `ch` here would resolve against this
       container's inherited 1rem, not against the 2.75rem lead inside it, so it
       reads as a sensible measure and lands at roughly half the intended width. */
    max-width: 38rem;
  }

  /* Hero.astro sizes its first body paragraph large and its last at CTA size.
     These two rules reproduce that, because the paragraphs no longer live in
     Hero's slot — see the note in the markup above. */
  .intro__lead {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .intro__contact {
    font-size: var(--fs-cta);
    font-weight: 200;
    line-height: 1.4;
  }

  /* The whole title is the link. Given a class so it opts out of the global
     inline-link underline in base.css — that treatment is tuned for links inside
     running prose and reads as heavy on a 2rem display heading. Colour on hover
     matches the article list on /articles/. */
  .featured__link {
    color: inherit;
    text-decoration: none;
    box-shadow: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .featured__link:hover,
  .featured__link:focus-visible {
    color: var(--accent);
  }
</style>
